# ============================================================================
# CD8 T CELL SUBCLUSTERING — PhenoCycler-Fusion NUH Cohort
# 
# Performs unsupervised Leiden clustering of CD8+ T cells using
# exhaustion and functional markers, followed by manual annotation
# of functional states based on marker expression dotplots.
#
# Markers used for clustering:
#   CD45RO, TCF-1, T-bet, PD-1, LAG3, TOX
#
# Input:
#   merged_adata.h5ad — AnnData object of all phenotyped cells
#                       with cell_type_annotation in .obs
#
# Output:
#   CD8 T cell subcluster annotations:
#     Effector, Effector memory, Exhausted memory,
#     Stem-like exhausted, Transitional exhausted,
#     Terminally exhausted, Noise
# ============================================================================

import anndata as ad
import scanpy as sc

# ============================================================================
# 1. LOAD DATA
# ============================================================================
merged_data = ad.read_h5ad("merged_adata.h5ad")

# ============================================================================
# 2. CLEAN AND STANDARDISE CELL TYPE ANNOTATIONS
# ============================================================================
# Remove cells with missing annotations
merged_data = merged_data[~merged_data.obs["cell_type_annotation"].isna()].copy()
merged_data.obs["cell_type_annotation"] = merged_data.obs["cell_type_annotation"].astype(str)

# Harmonise cell type labels across batches
label_map = {
    "B cells"                      : "Malignant B cell",
    "CD4 T cell"                   : "CD4 T cell",
    "CD4 T cells"                  : "CD4 T cell",
    "CD8 T cell"                   : "CD8 T cell",
    "CD8 T cells"                  : "CD8 T cell",
    "DC"                           : "DC",
    "DCs"                          : "DC",
    "Endothelial cells"            : "Endothelial cell",
    "FDC"                          : "Malignant B cell",
    "Fibroblast"                   : "Fibroblast",
    "Fibroblast cells"             : "Fibroblast",
    "Fibroblasts"                  : "Fibroblast",
    "Follicular Dendritic cells"   : "Malignant B cell",
    "Granulocytes"                 : "Malignant B cell",
    "Lymphatic Endothelial Cells"  : "Endothelial cell",
    "Lymphatic Endothelial cells"  : "Endothelial cell",
    "Lymphatic endothelial cells"  : "Endothelial cell",
}
merged_data.obs["cell_type_annotation"] = (
    merged_data.obs["cell_type_annotation"].map(label_map)
    .fillna(merged_data.obs["cell_type_annotation"])
)

# ============================================================================
# 3. SUBSET TO CD8 T CELLS
# ============================================================================
clustered_CD8_data = merged_data[
    merged_data.obs["cell_type_annotation"] == "CD8 T cell"
].copy()

# ============================================================================
# 4. LEIDEN CLUSTERING ON EXHAUSTION/FUNCTIONAL MARKERS
# ============================================================================
# Clustering performed on the following markers:
#   CD45RO (memory), TCF-1 (stemness), T-bet (effector),
#   PD-1, LAG3, TOX (exhaustion)
# Standard scanpy neighbourhood graph + Leiden clustering

sc.pp.neighbors(clustered_CD8_data)
sc.tl.leiden(clustered_CD8_data)
sc.tl.umap(clustered_CD8_data)

# ============================================================================
# 5. MARKER GENE RANKING PER CLUSTER
# ============================================================================
# Used to guide manual annotation of functional states
sc.tl.rank_genes_groups(
    clustered_CD8_data,
    groupby = "leiden",
    method  = "t-test"
)
sc.pl.rank_genes_groups_dotplot(clustered_CD8_data)

# ============================================================================
# 6. MANUAL ANNOTATION OF CD8 FUNCTIONAL STATES
# ============================================================================
# Cluster labels assigned based on marker expression dotplots.
# Annotation reflects canonical CD8 T cell exhaustion trajectory:
#   Effector → Effector memory → Exhausted memory
#   → Transitional exhausted → Stem-like exhausted
#   → Terminally exhausted

cluster_to_celltype = {
    "0"  : "Exhausted memory",
    "1"  : "Stem-like exhausted",
    "2"  : "Effector memory",
    "3"  : "Effector memory",
    "4"  : "Transitional exhausted",
    "5"  : "Effector",
    "6"  : "Transitional exhausted",
    "7"  : "Terminally exhausted",
    "8"  : "Stem-like exhausted",
    "9"  : "Noise",
    "10" : "Effector memory",
    "11" : "Terminally exhausted",
    "12" : "Terminally exhausted",
}

clustered_CD8_data.obs["CD8_subtype"] = (
    clustered_CD8_data.obs["leiden"].map(cluster_to_celltype)
)

# ============================================================================
# 7. VISUALISE
# ============================================================================
sc.pl.umap(
    clustered_CD8_data,
    color  = ["CD8_subtype"],
    title  = "CD8 T cell functional states",
    legend_loc = "on data"
)

sc.pl.dotplot(
    clustered_CD8_data,
    var_names = ["CD45RO", "TCF-1", "T-bet", "PD-1", "LAG3", "TOX"],
    groupby   = "CD8_subtype",
    standard_scale = "var"
)

# ============================================================================
# 8. SAVE
# ============================================================================
clustered_CD8_data.write("CD8_subclustered.h5ad")
